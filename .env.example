# ZAREN Perfume — Environment Variables
# Copy this file to .env and fill in real values.
# In production, use your platform's secret management — never commit .env.

# Admin dashboard password (change in production!)
ADMIN_PASSWORD=zaren_admin_2024

# JWT secret for admin sessions (change in production!)
JWT_SECRET=change_this_to_a_long_random_string

# Data directory for JSON store (default: ./data)
DATA_DIR=./data

# Upload directory for images (default: ./public/uploads)
UPLOAD_DIR=./public/uploads

# Optional: Supabase credentials for production database/storage
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Base URL for canonical URLs (set to your production domain)
# NEXT_PUBLIC_BASE_URL=https://zarenperfume.com
